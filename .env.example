# Copiar a .env (ignorado por git). Lo lee docker compose para pasarle las
# credenciales a la API: sin ellas, subir imagenes desde el panel responde 503.
#
# Los valores estan en el dashboard de Cloudinary, en Settings > API Keys.
CLOUDINARY_CLOUD_NAME=dppftc5to
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=oriente
