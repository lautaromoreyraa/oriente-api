# Copiar a application-local.yaml (ignorado por git) y completar.
# Solo hace falta para correr la API desde el IDE contra la base del compose:
#
#   docker compose up db
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# Con "docker compose up" completo no se usa: ahi los valores vienen del compose.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/oriente?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: oriente
    password: oriente

oriente:
  seguridad:
    administrador:
      usuario: orienteadmin
      password: CAMBIAR
    jwt:
      # Cualquier cadena larga sirve en desarrollo. En produccion la genera Railway
      # y no se parece a esta.
      secret: CAMBIAR-POR-UNA-CADENA-DE-AL-MENOS-64-CARACTERES-PARA-HMAC-SHA256
  cloudinary:
    # Se consiguen en el dashboard de Cloudinary. Sin esto, subir imagenes desde
    # el panel no funciona; el resto de la API si.
    nombre-de-la-nube: dppftc5to
    api-key: CAMBIAR
    api-secret: CAMBIAR
    carpeta: oriente
